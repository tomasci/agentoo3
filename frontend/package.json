    "@tanstack/react-table": "8.9.9",
    "axios": "1.20.0",
    "consola": "3.4.2",
    "i18next": "26.4.1",
    "i18next-browser-languagedetector": "8.2.1",
    "jotai": "2.20.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-i18next": "17.0.13",
    "react-markdown": "10.1.0",
