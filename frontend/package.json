    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "^20.13.2",
    "kubb": "5.0.5",
    "lefthook": "2.1.12",
    "sass": "1.103.1",
    "stylelint": "16.26.0",
