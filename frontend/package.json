{
  "name": "agentoo-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.47",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "bun run server.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
