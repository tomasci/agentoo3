# Template. Copy to .env and fill in what the installer does not generate.
#
# NOTE: the installer WRITES to .env directly — the postgres and redis steps
# generate passwords and append DATABASE_URL / REDIS_URL. Re-running them reuses
# whatever is already there, so your credentials stay stable. .env is created
# mode 0600 and is gitignored. Never commit it.

# ------------------------------------------------------------------ general ---
APP_NAME=agentoo
APP_ENV=production          # development | production
LOG_LEVEL=info

# ------------------------------------------------------------------ backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated origin allowlist for the API. Leave empty: nginx serves the
# frontend and /api/ from one origin, and the Vite dev server proxies /api, so
# nothing legitimate is cross-origin. There is no app-level auth, so a permissive
# value here lets any page a tailnet browser visits drive this API.
CORS_ORIGINS=

# ----------------------------------------------------------------- frontend ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
# Public URL the browser uses to reach the backend. nginx maps /api/ -> backend.
PUBLIC_API_URL=/api

# ---------------------------------------------------------------- providers ---
# Claude Code needs ONE of these. See "Authenticating on a headless server" in
# the README. Precedence: ANTHROPIC_AUTH_TOKEN > ANTHROPIC_API_KEY >
# CLAUDE_CODE_OAUTH_TOKEN.
#
# Subscription (Pro/Max/Team/Enterprise) — one-year token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Console API key (pay-as-you-go) from https://platform.claude.com.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------- postgresql ---
# Generated by scripts/60-install-postgres.sh if left blank.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agentoo
POSTGRES_USER=agentoo
POSTGRES_PASSWORD=
DATABASE_URL=

# -------------------------------------------------------------------- redis ---
# Generated by scripts/62-install-redis.sh if left blank.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# -------------------------------------------------------------- attachments ---
# ATTACHMENTS_DIR                  (generated by the installer; default <repo>/attachments)
# Same treatment as the other data directories: scripts/68-setup-backend.sh
# writes it into .env itself via env_set, so there is nothing to fill in here.
#
# Keep ATTACHMENT_MAX_BYTES below nginx's client_max_body_size (50m today,
# NGINX_CLIENT_MAX_BODY_SIZE in scripts/lib/config.sh) — above it, nginx
# returns its own 413 before the request reaches the API, so the app never
# gets a chance to produce its own error message.
ATTACHMENT_MAX_BYTES=26214400            # 25 MiB per file
ATTACHMENTS_SESSION_MAX_BYTES=209715200  # 200 MiB per session
ATTACHMENTS_SESSION_MAX_FILES=50
ATTACHMENTS_TOTAL_MAX_BYTES=5368709120   # 5 GiB across all sessions
ATTACHMENTS_GC_INTERVAL_MS=3600000       # reconciliation sweep, hourly
ATTACHMENTS_GC_GRACE_MS=86400000         # 24h before an orphan blob is swept
ATTACHMENTS_RETENTION_DAYS=0             # 0 = retention purge disabled
