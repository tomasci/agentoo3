# Template. Copy to .env and fill in what the installer does not generate.
#
# NOTE: the installer WRITES to .env directly — the postgres and redis steps
# generate passwords and append DATABASE_URL / REDIS_URL. Re-running them reuses
# whatever is already there, so your credentials stay stable. .env is created
# mode 0600 and is gitignored. Never commit it.

# ------------------------------------------------------------------ general ---
APP_NAME=agentoo
APP_ENV=production          # development | production
LOG_LEVEL=info

# ------------------------------------------------------------------ backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated origin allowlist for the API. Leave empty: nginx serves the
# frontend and /api/ from one origin, and the Vite dev server proxies /api, so
# nothing legitimate is cross-origin. There is no app-level auth, so a permissive
# value here lets any page a tailnet browser visits drive this API.
CORS_ORIGINS=

# ----------------------------------------------------------------- frontend ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
# Public URL the browser uses to reach the backend. nginx maps /api/ -> backend.
PUBLIC_API_URL=/api

# ---------------------------------------------------------------- providers ---
# Claude Code needs ONE of these. See "Authenticating on a headless server" in
# the README. Precedence: ANTHROPIC_AUTH_TOKEN > ANTHROPIC_API_KEY >
# CLAUDE_CODE_OAUTH_TOKEN.
#
# Subscription (Pro/Max/Team/Enterprise) — one-year token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Console API key (pay-as-you-go) from https://platform.claude.com.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------- postgresql ---
# Generated by scripts/60-install-postgres.sh if left blank.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agentoo
POSTGRES_USER=agentoo
POSTGRES_PASSWORD=
DATABASE_URL=

# -------------------------------------------------------------------- redis ---
# Generated by scripts/62-install-redis.sh if left blank.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# -------------------------------------------------------------- attachments ---
# ATTACHMENTS_DIR                  (generated by the installer; default <repo>/attachments)
# Same treatment as the other data directories: scripts/68-setup-backend.sh
# writes it into .env itself via env_set, so there is nothing to fill in here.
#
# Keep ATTACHMENT_MAX_BYTES below nginx's client_max_body_size (50m today,
# NGINX_CLIENT_MAX_BODY_SIZE in scripts/lib/config.sh) — above it, nginx
# returns its own 413 before the request reaches the API, so the app never
# gets a chance to produce its own error message.
ATTACHMENT_MAX_BYTES=26214400            # 25 MiB per file
ATTACHMENTS_SESSION_MAX_BYTES=209715200  # 200 MiB per session
ATTACHMENTS_SESSION_MAX_FILES=50
ATTACHMENTS_TOTAL_MAX_BYTES=5368709120   # 5 GiB across all sessions
# Idea-owned assets (uploaded before a session exists) get their own pair
# of caps, cloned from the session pair above.
ATTACHMENTS_IDEA_MAX_BYTES=209715200     # 200 MiB per idea
ATTACHMENTS_IDEA_MAX_FILES=50
ATTACHMENTS_GC_INTERVAL_MS=3600000       # reconciliation sweep, hourly
ATTACHMENTS_GC_GRACE_MS=86400000         # 24h before an orphan blob is swept
ATTACHMENTS_RETENTION_DAYS=0             # 0 = retention purge disabled

# Idea Manager: converting one idea's canvas into a development prompt is a
# single, short, tool-less model call, nothing like a session turn, so it gets
# its own knobs rather than sharing WORKER_CONCURRENCY / a session's own budget.
IDEA_PROMPT_CONCURRENCY=4
IDEA_PROMPT_MAX_TURNS=6                   # SDK round-trips allowed; maxBudgetUsd/timeout are the real bounds
IDEA_PROMPT_MAX_BUDGET_USD=1              # per-generation ceiling, USD
IDEA_PROMPT_TIMEOUT_MS=120000             # 2 minutes before the call is aborted
IDEA_HANDOFF_CLAIM_GRACE_MS=120000        # before a promptId-less claim is treated as crashed

# Docker feature: running a project's own Dockerfile/compose is arbitrary code
# execution on the host, at whatever privilege the docker daemon has — see
# backend/README.md's "Docker" section. Kill switch, independent of anything
# per-project: false disables every start/stop/restart/down (403) while state
# reads (GET /projects/{id}/docker) and detection keep working.
#
# The `docker` step of the top-level installer (scripts/65-install-docker.sh)
# writes this line itself, from its own DOCKER_ENABLE knob — see the top-level
# README's "Docker" section. Editing it by hand still works; a later install
# run just overwrites it from DOCKER_ENABLE again.
DOCKER_ENABLED=true
# Ceiling for one queued docker-op job (compose up --build, most often).
DOCKER_OP_TIMEOUT_MS=1800000                    # 30 minutes

# Editor feature: a per-session code-server container (backend/README.md's
# "Editor" section). A second, independent kill switch layered on top of
# DOCKER_ENABLED above — the effective flag is DOCKER_ENABLED && EDITOR_ENABLED
# (`editorEnabled` in backend/src/env.ts) — so an operator who wants docker
# controls but no per-session editor (or vice versa) can turn off just one.
EDITOR_ENABLED=true
# Pinned, not `:latest` — verified against this exact tag's digest (Debian,
# not the `-39` Fedora variant) and every `--disable-*`/`--socket` flag this
# feature passes it. Changing this is a real upgrade decision, not a rolling one.
EDITOR_IMAGE=codercom/code-server:4.138.0
# Route-side fast-path only; the worker's own count under editor-op's
# concurrency 1 is the real limit.
EDITOR_MAX_RUNNING=2
# docker run --memory / --cpus for one editor container.
EDITOR_MEMORY_LIMIT=1g
EDITOR_CPUS=1
# code-server --idle-timeout-seconds: exits on its own once idle this long,
# so an editor nobody is using stops holding its memory/cpu share. The reaper
# (features/editor/reaper.ts) removes the now-stopped container afterwards.
EDITOR_IDLE_TIMEOUT_SECONDS=1800
# Both the start lock's TTL and the worker's own deadline for one start job —
# see backend/src/env.ts's own comment for why the two share one value.
EDITOR_START_TIMEOUT_MS=600000
