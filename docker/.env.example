# Example env file for the compose dev/test stack (../compose.yaml).
#
# Copy this to the REPO ROOT as `.env`, not here — docker compose reads a
# `.env` from the same directory as the compose file it runs (the repo root),
# never from docker/:
#
#   cp docker/.env.example .env
#
# That root `.env` is also what install.sh's steps write real credentials
# into for the bare-metal install (see the repo root's own .env.example). The
# two coexist on purpose: every variable below is prefixed AGENTOO_ precisely
# so it cannot collide with that file's BACKEND_PORT/POSTGRES_PORT/etc, and
# ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN are read under the exact same
# names either way, so credentials you already have in a root `.env` are
# picked up by the stack with nothing to duplicate. Uncomment only what you
# need to override — every line below is already compose.yaml's own default.

# ---- host ports (defaults chosen to not collide with a bare-metal install's
#      own 8000/3000/5432/6379 on this same machine) -------------------------
# AGENTOO_API_PORT=8100
# AGENTOO_FRONTEND_PORT=3100
# AGENTOO_POSTGRES_PORT=55432
# AGENTOO_REDIS_PORT=56379

# ---- Claude credentials (optional; the API boots without either, but no
#      agent can run until one is set — see docker/README.md) ---------------
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
